---
import '../styles/global.css';
interface Props {
    inputid ?: string,
    accept ?: string
}
const { inputid, accept } = Astro.props;
---
<style is:global>
    .custom-file-upload {
        display: flex;
        padding: 8px;
        align-items: center;
        justify-content: space-between;
        text-align: right;
        gap: 12px;
        border: 2px dotted var(--primary-color);
        border-radius: 10px;
        background: radial-gradient(#0000 10%, var(--secondary-color));
        background-size: 200% 200%;
        background-position: center;
        cursor: pointer;
        max-width: 12em;

        position: relative;
        overflow: hidden;
    }

    .custom-file-upload.uploaded {
        border: 2px solid var(--primary-color);
        background: radial-gradient(#0000 5%, var(--primary-color));
        background-size: 200% 200%;
        background-position: center;
    }

    input.file {
        cursor: pointer;
        position: absolute;
        -moz-opacity: 0;
        filter: alpha(opacity: 0);
        opacity: 0;
        z-index: 0;
        font-size: 3em;
    }

    input.file::file-selector-button {
        cursor: pointer;
    }
</style>
<div class="custom-file-upload phantommuff">
    <input type="file" class="file" id={inputid} accept={accept}/>
    <img src={(import.meta.env.DEV?'':import.meta.env.BASE_URL)+'/'+"img/icons/pixel/upload.png"} alt=" " width="16" height="16" style="image-rendering: pixelated;"/>
    <span>Upload...</span>
</div>
<script>
    var all = document.querySelectorAll('input[type="file"]');
    all.forEach((a:any) => {
        a.onchange = function() {
            const label = a.parentNode;
            const span = label.children[2];
            if (a.files[0] != null) {
                const fileName = a.files[0].name;
                if (span) span.innerText = fileName;
                label.classList.add('uploaded');
            } else {
                if (span) span.innerText = 'Upload...';
                label.classList.remove('uploaded');
            }
        };
    });
</script>