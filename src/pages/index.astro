---
import { getCollection } from "astro:content";
import Page from '../components/Page.astro';
import Mod from '../components/Mod.astro';
import poop from '../donators.json';

const modsCollection = await getCollection("mods");
const mods = modsCollection.map((data:any) => data);

mods.sort((a:any, b:any) => {
    return Date.parse(b.data.lastUpdated) - Date.parse(a.data.lastUpdated);
});

function getTotalDonations(d:any):number {
	var amount = 0;
	for (let i = 0; i < d.donations.length; i++) {
		amount += d.donations[i].amount;
	}
	return amount;
}

const donators = poop.donators.sort((a, b) => {
    return getTotalDonations(b) - getTotalDonations(a);
});

function getIconButton(i:string) {
	return `<img src="${(import.meta.env.DEV?'':import.meta.env.BASE_URL)}/img/icons/${i}.svg" height="20" style="margin-right: 7px;"/> `
}
// this sucks
function getShowCondition(a:any) {
	var ret = "'All'";
	if (a.data.tags != undefined) {
		if (a.data.lastUpdated == 'unreleased') ret = ",'Upcoming'";
		if (a.data.tags.includes('featured')) ret += ",'Featured'";
		if (a.data.tags.includes('loved')) ret += ",'Loved'";
		if (a.data.tags.includes('admin-pick')) ret += ",'Admin Pick'";
	}
	return `[${ret}].includes(curSelected)`;
}
---
<style is:global>
	div.container {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 16px;
	}

	.mod-container {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4px;
		overflow: hidden auto;
		max-height: 100%;
	}

	@media screen and (max-width: 1000px) {
		div.container {
			display: block;
		}
	}

	td {
		margin: 20px;
	}

	td.name {
		display: flex;
		align-items: start;
		font-size: 0.8em;
	}

	.experimental-table-elem {
		box-shadow: 0px 1px 0px var(--primary-color) inset;
	}

	.donator {
		border: 1px solid #000;
		background-color: var(--background-secondary-color);
		text-shadow: 1px 1px 2px var(--secondary-color);
	}

	.donator:first-child {
		border: 1px solid #d7a537;
		background-color: #725d2f;
	}

	.donator:nth-child(2) {
		border: 1px solid #a3a3a3;
		background-color: #5f5f5f;
	}
</style>
<Page desc="Website dedicated to things for Codename Engine!">
	<div class="container">
		<div class="panel phantommuff" style="text-align: center;">
			<img src={(import.meta.env.DEV?'':import.meta.env.BASE_URL)+'/'+"img/codename-animated.webp"} alt="Codename Engine" height="361" style="width: 44vw; height: auto;"/>
			<br/>
			Codename Engine is a fork of <a href="https://funkin.me/" target="_blank">Friday Night Funkin'</a>
			<br/>with a focus on softcoding and modding.
			<br/><br/>
			<h2>Downloads</h2>
			<table style="text-align: left; margin: auto;" class="subpanel">
				<tr>
					<td class="name">Stable</td>
					<td>
						<div style="display: flex;">
						{
							[
								{name:`${getIconButton('github')} GitHub`, 			link: "https://github.com/CodenameCrew/CodenameEngine/releases"},
							 	{name:`${getIconButton('gamebanana')} GameBanana`, 	link: "https://gamebanana.com/mods/download/598553"},
							 	{name:`${getIconButton('itch')} itch.io`, 		   	link: "https://nex-isdumb.itch.io/codename-engine/purchase"}
							].map((j) => (
								<a href={j.link} style="text-decoration: none;">
								<button set:html={j.name}/>
								</a>
							))
						}
						</div>
					</td>
				</tr>
				<tr class="experimental-table-elem">
					<td class="name">Experimental<br/>(downloadable)<span style="font-size: 4em;">*</span></td>
					<td>
						<div style="display: flex;">
						{
							[
								{name:`${getIconButton('os/windows')} Windows`, link: "https://nightly.link/CodenameCrew/CodenameEngine/workflows/windows/main/Codename%20Engine.zip"},
								{name:`${getIconButton('os/apple')} MacOS`, 	link: "https://nightly.link/CodenameCrew/CodenameEngine/workflows/macos/main/Codename%20Engine.zip"},
								{name:`${getIconButton('os/linux')} Linux`, 	link: "https://nightly.link/CodenameCrew/CodenameEngine/workflows/linux/main/Codename%20Engine.zip"}
							].map((j) => (
								<a href={j.link} style="text-decoration: none;">
								<button set:html={j.name}/>
								</a>
							))
						}
						</div>
						<p style="width: 24em;">
							* <span style="color: var(--primary-color); font-size: 0.9em;">These downloads come directly from our GitHub Actions and run on the latest changes.<br/>They might be unstable as they're really new, use them at risk of bugs!</span>
						</p>
					</td>
				</tr>
			</table>
			<br/>
			Make sure to join our official <a href="https://discord.gg/codename-crew" target="_blank">Discord Server</a>!
			<br/>You can contribute to this website by going to the <a href="https://github.com/CodenameCrew/codename-website/" target="_blank">Website repository</a>
			<br/>You can find the engine source by going to the <a href="https://github.com/CodenameCrew/CodenameEngine/" target="_blank">Engine repository</a>
		</div>
		<div class="panel" style="display: flex; flex-direction: column;" x-data="{ curSelected: 'All' }">
			<div style="display: flex; align-items: center; justify-content: space-between;">
				<h2 style="margin: 0;">Mods</h2>
				<div style="display: flex; justify-content: center; margin-bottom: 5px;">
					<a href="https://deltarune.com/lancer/" target="_blank" style="text-decoration: none; width: 100%;">
						<button style="width: 100%; margin: 0;" set:html={`${getIconButton('external')} Submit your own!`}/>
					</a>
				</div>
			</div>
			<div style="display: flex; justify-content: center; margin-bottom: 5px;">
			{
				['All', 'Featured', 'Admin Pick', 'Upcoming'].map((a) => (
					<button x-on:click={`curSelected = '${a}'`} x-bind:class={`curSelected == '${a}' ? null : 'col-black'`}
					style="width: 100%;">{a}</button>
				))
			}
			</div>
			<hr style="width: 100%;"/>
			<div class="subpanel" style="height: 60vh;">
				<div class="mod-container">
				{
					(mods.length > 0) ? mods.map((a:any) => (
						<Mod data={a.data} id={a.id} show={getShowCondition(a)} />
					)) : (
						<div style="width: 200%;">
						<h2 style="margin: 0;">Nothing here yet...</h2>
						<i>One day... a mod will be here... it may be yours... hopefully.</i><br/>						
						</div>
					)
				}
				</div>
			</div>
		</div>
		<div class="panel" style="grid-column: 1/3; padding: 32px; padding-top: 0; text-align: center;">
			<h2>Donators</h2>
			<p class="phantommuff" style="width: 48em; margin: auto;">
				Donations help support the engine's development. If you really REALLY like the engine, consider donating to our <a href="https://ko-fi.com/codename_engine/">Ko-fi</a>!
				You can also access it with the button at the bottom left.
			</p>
			<br/>
			<div style="display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;">
				{
					donators.map((a) => (
						<div class="donator" style={
							`text-align: left; display: flex; gap: 5px; padding: 8px; width: fit-content; `
							+ (a.hasMembership && `box-shadow: 0px 0px 8px #ff0;`) // care
						}>
							<img src={a.profilePicture} width="32" height="32"/>
							<div>
								<b style="margin: 0; width: fit-content;">{a.name}</b>
								<p style="margin: 0; width: fit-content;" class="">&dollar;{getTotalDonations(a)}</p>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>

	<!--
		TODO: implement the widget
		PLEASE i cant get it to work somehow
	-->
	<!--<button onclick='window.open("https://ko-fi.com/codename_engine", "_blank")' style="border-radius: 2px; position: fixed; bottom: 1vw; left: 1vw; z-index: 999;">
		<img src="https://storage.ko-fi.com/cdn/logomarkLogo.png" width="20" alt="Ko-fi"/>&nbsp;Donate
	</button> -->

	<script src='https://storage.ko-fi.com/cdn/scripts/overlay-widget.js' is:inline/>
	<script is:inline>
	kofiWidgetOverlay.draw('codename_engine', {
		'type': 'floating-chat',
		'floating-chat.donateButton.text': 'Donate',
		'floating-chat.donateButton.background-color': '#b265bd',
		'floating-chat.donateButton.text-color': '#fff',
		'floating-chat.stylesheets': '["https://codename-engine.com/ko-fi.css"]',
	});
	</script>
</Page>