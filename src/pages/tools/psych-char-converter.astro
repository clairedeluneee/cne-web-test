---
import Page from '../../components/Page.astro';
import FileUpload from '../../components/FileUpload.astro';
import '../../styles/code.css';
---
<Page title="Psych Character Converter">
    <script src="https://unpkg.com/prismjs@1.30.0/prism.js"/>
    <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"/>

    <div class="panel" style="text-align: center; width: fit-content; margin: auto;">
        <div class="phantommuff">
            <h1 style="margin: 0.2em;">Psych Character Converter</h1>
            Converts a Psych Engine character JSON to a Codename character XML
            <br/>
            <b>Warning:</b> Offsets may not be fully accurate.
            <br/><br/>
        </div>
        <hr/>
        <div style="display: grid; grid-template-columns: 1fr 1.5fr; gap: 12px; width: 82vw;">
            <div class="subpanel" style="display: flex; flex-direction: column;">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 3px;">
                    <div style="display: flex; align-items: center; gap: 12px; text-align: left;">
                        <img src={(import.meta.env.DEV?'':import.meta.env.BASE_URL)+'/'+"img/icons/pixel/json.png"} alt=" " width="16" height="16" style="image-rendering: pixelated;"/>
                        <span class="phantommuff">Input File (.json)</span>
                    </div>
                    <div style="margin: 3px; display: flex; gap: 12px;">
                        <button
                        class="col-black custom-file-upload" style="
                        margin: 0; border-radius: 8px;
                        padding: 8px; font-size: 1.2em;
                        border: 2px dotted #dfae0e;" title="Convert Entire Folder">
                        📂
                        <input type="file" class="file" directory webkitdirectory mozdirectory id="folder-upload"/>
                        </button>
                        <FileUpload inputid="upload" accept=".json"/>
                    </div>
                </div>
                <textarea id="input-textarea" class="subpanel code" placeholder='{\n  ...\n}'
                style="resize: none; border: 2px solid var(--secondary-color); display: flex; height: 100%;" />
            </div>
            <div class="subpanel" style="display: flex; flex-direction: column;">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 3px;">
                    <div style="display: flex; align-items: center; gap: 12px; text-align: left;">
                        <img src={(import.meta.env.DEV?'':import.meta.env.BASE_URL)+'/'+"img/icons/pixel/xml.png"} alt=" " width="16" height="16" style="image-rendering: pixelated;"/>
                        <span class="phantommuff">Output File (.xml)</span>
                    </div>
                    <button id="download">
                        <img src={(import.meta.env.DEV?'':import.meta.env.BASE_URL)+'/'+"img/icons/pixel/download.png"} alt=" " width="16" height="16" style="image-rendering: pixelated;"/>
                        &nbsp;Download
                    </button>
                </div>
                <pre id="output-textarea" class="subpanel code"
                style="text-align: left; border: 2px solid var(--secondary-color); height: 20em; margin: 0; overflow: auto;" />
            </div>
        </div>
    </div>

    <script>
        const parser = new DOMParser();
        function convertCharacter(jsonString:string, charName?:string) {
            var json = JSON.parse(jsonString);
            var __xml:Document = parser.parseFromString("<!DOCTYPE codename-engine-character>\n<!-- Made with WizardMantis's Character Converter on https://codename-engine.com/tools/psych-char-converter/ -->\n<character>\n</character>", "text/xml");
            var xml = __xml.children[0]; // the <character> node

            var amazingScale = 1;
            if (json.scale && json.scale != 1) amazingScale = json.scale;
            if (amazingScale != 1) xml.setAttribute('scale', amazingScale.toString());
            if (json.sing_duration && json.sing_duration != 4) xml.setAttribute('holdTime', json.sing_duration.toString());
            if (json.no_antialiasing != false) xml.setAttribute('antialiasing', (!json.no_antialiasing).toString());
            // 1.0+
            if (json._editor_isPlayer != null && json._editor_isPlayer !== false) xml.setAttribute('flipX', json._editor_isPlayer.toString());
            if (json.flip_x != (json._editor_isPlayer ?? false)) xml.setAttribute('flipX', json.flip_x.toString());
            
            if (json.healthbar_colors) {
                xml.setAttribute('color', '#' + (
                    (json.healthbar_colors[0] << 16)
                    + (json.healthbar_colors[1] << 8)
                    + json.healthbar_colors[2]
                ).toString(16).padStart(6, '0'));
            }

            if (json.position) {
                if (json.position[0] !== 0) xml.setAttribute('x', json.position[0].toString());
                if (json.position[1] !== 0) xml.setAttribute('y', json.position[1].toString());
            }

            if (json.camera_position) {
                if (json.camera_position[0] !== 0) xml.setAttribute('camx', json.camera_position[0].toString());
                if (json.camera_position[1] !== 0) xml.setAttribute('camy', json.camera_position[1].toString());
            }

            if (json.healthicon && charName && json.healthicon != charName) xml.setAttribute('icon', json.healthicon.toString());
            if (json.image) {
                // psych 1.0+ has multisheet
                const imageSplit = json.image.toString().split(',');
                var defImage:string  = imageSplit.shift().trim();
                if (defImage.startsWith('characters/')) defImage = defImage.substring('characters/'.length, defImage.length);
                if (charName && charName != defImage) xml.setAttribute('sprite', defImage);

                while (imageSplit.length > 0) {
                     var defImage:string  = imageSplit.shift().trim();
                    if (defImage.startsWith('characters/')) defImage = defImage.substring('characters/'.length, defImage.length);
                    var spritesheet = __xml.createElement('sheet'); // <spritesheet> works too but its long so i dont like it
                    spritesheet.setAttribute('path', defImage);
                    if (charName && charName != defImage) xml.appendChild(spritesheet);
                }
            }

            if (json.animations.length > 0) {
                var defaultFPSScanned = json.animations[0].fps ?? 24;
                for (var i = 0; i < json.animations.length; i++) {
                    if (defaultFPSScanned != json.animations[0].fps) {
                         break;
                    }
                }

                if (defaultFPSScanned != 24) xml.setAttribute('defFps', defaultFPSScanned.toString());

                while (json.animations.length > 0) {
                    var jsonAnim = json.animations.shift();
                    var anim = __xml.createElement('anim');
                    // psych swaps name and anim
                    anim.setAttribute('name', jsonAnim.anim.replace(/-hold$/, '-loop'));
                    anim.setAttribute('anim', jsonAnim.name);
                    if (jsonAnim.offsets) {
                        if (jsonAnim.offsets[0] !== 0) anim.setAttribute('x', (jsonAnim.offsets[0] / amazingScale).toString());
                        if (jsonAnim.offsets[1] !== 0) anim.setAttribute('y', (jsonAnim.offsets[1] / amazingScale).toString());
                    }
                    if (jsonAnim.fps !== defaultFPSScanned) anim.setAttribute('fps', jsonAnim.fps.toString());
                    if (jsonAnim.loop !== false) anim.setAttribute('loop', jsonAnim.loop.toString());
                    if (jsonAnim.indices && jsonAnim.indices.length > 0) {
                        anim.setAttribute('indices', formatNumberRange(jsonAnim.indices));
                    }
                    xml.appendChild(anim);
                }
            }

            return __xml;
        }

        var upload_butt = document.getElementById('upload') as HTMLInputElement;
        var download_butt = document.getElementById('download') as HTMLButtonElement;
        if (download_butt != null) {
            download_butt.addEventListener('click', async (e:MouseEvent) => {
                if (upload_butt.files == null || upload_butt.files.length < 1) {
                    window.alert('Upload a character first!');
                    return;
                };
                try {
                    if (download_butt != null) {
                        download_butt.style.cursor = 'wait';
                        download_butt.disabled = true;
                    }

                    const niceValue = await upload_butt.files[0].text();
                    const xmlOutput = xmlToString(convertCharacter(niceValue, upload_butt.files[0].name.replace(/.json$/, '')));
                    var filename = upload_butt.files[0].name.replace(/.json$/, '.xml');
                    var element = document.createElement('a');
                    element.setAttribute('href', 'data:text/plain;charset=utf-8,' + encodeURIComponent(xmlOutput));
                    element.setAttribute('download', filename);
                    element.style.display = 'none';
                    document.body.appendChild(element);
                    element.click();
                    document.body.removeChild(element);

                    if (download_butt != null) {
                        download_butt.style.cursor = '';
                        download_butt.disabled = false;
                    }
                } catch(e:any) {
                    window.alert(e.toString());
                }
            });
        }

        if (upload_butt != null) {
            upload_butt.addEventListener('change', async () => {
                try {
                    if (upload_butt.files == null || upload_butt.files.length < 1) return;
                    const niceValue = await upload_butt.files[0].text();
                    const xmlOutput = xmlToString(convertCharacter(niceValue, upload_butt.files[0].name.replace(/.json$/, '')));
                    (document.getElementById('input-textarea') as HTMLInputElement).value = niceValue;
                    (document.getElementById('output-textarea') as HTMLElement).innerHTML = Prism.highlight(xmlOutput, Prism.languages.xml, 'xml');
                } catch(e:any) {
                    window.alert(e.toString());
                }
            });
        }

        // "JSZip is not defined" my ass
        var zip:any = null;
        var folder_butt = document.getElementById('folder-upload') as HTMLInputElement;
        if (folder_butt != null) {
            folder_butt.addEventListener('change', async () => {
                try {
                    if (folder_butt.files == null) return;
                    if (zip == null) zip = new JSZip();
                    var idiot = new Map();
                    for (var i = 0; i < folder_butt.files.length; i++) {
                        var file = folder_butt.files[i];
                        if (!file.name.endsWith('.json')) continue;
                        const niceValue = await file.text();
                        const name = file.name.replace(/.json$/, '');
                        idiot.set(name + '.xml', xmlToString(convertCharacter(niceValue, name)));
                    }
                    for (const i of idiot) {
                        zip.file(i[0], i[1]);
                    }
                    zip.generateAsync({type:"base64"}).then(function (base64) {
                        var element = document.createElement('a');
                        element.setAttribute('href', "data:application/zip;base64," + base64);
                        element.setAttribute('download', 'characters.zip');
                        element.style.display = 'none';
                        document.body.appendChild(element);
                        element.click();
                        document.body.removeChild(element);
                    }, function (err:any) {
                        throw err;
                    });
                } catch(e:any) {
                    window.alert(e.toString());
                }
            });
        }

        const serializer = new XMLSerializer();
        function xmlToString(xml:Document) {
            var quickInput = serializer.serializeToString(xml);
            var output = quickInput.replace(/(>)\s*(<)(\/*)/g, '$1\r\n$2$3');
            // lazy indenting
            output = output.replace(/<(anim|sheet|spritesheet)/g, '\t<$1');
            return output;
        }

        // evil copy paste from cne itself lol
        function formatNumberRange(numbers:number[], separator:string = ","):string {
            if (numbers.length == 0) return "";

            var result:Array<String> = [];
            var i = 0;

            while (i < numbers.length) {
                var start = numbers[i];
                var end = start;
                var direction = 0; // 0: no sequence, 1: increasing, -1: decreasing

                if (i + 1 < numbers.length) { // detect direction of sequence
                    if (numbers[i + 1] == end + 1) {
                        direction = 1;
                    } else if (numbers[i + 1] == end - 1) {
                        direction = -1;
                    }
                }

                if(direction != 0) {
                    while (i + 1 < numbers.length && (numbers[i + 1] == end + direction)) {
                        end = numbers[i + 1];
                        i++;
                    }
                }

                if (start == end) { // no direction
                    result.push(`${start}`);
                } else if (start + direction == end) { // 1 step increment
                    result.push(`${start},${end}`);
                } else { // store as range
                    result.push(`${start}..${end}`);
                }

                i++;
            }

            return result.join(separator);
        }
    </script>
</Page>